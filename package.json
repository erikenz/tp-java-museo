{
  "name": "tp-java-museo",
  "private": true,
  "scripts": {
    "dev": "trap 'nx run services:dev:teardown' EXIT; nx run-many --target=dev --parallel=true",
    "db": "pnpm --filter @museo/services up",
    "db:stop": "pnpm --filter @museo/services down",
    "build": "nx run-many --target=build",
    "test": "nx run-many --target=test",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@nx/gradle": "^20.0.0",
    "@nx/js": "^20.0.0",
    "concurrently": "^9.1.0",
    "nx": "^20.0.0",
    "typescript": "^5.7.0"
  }
}
