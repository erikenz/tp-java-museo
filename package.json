{
  "name": "tp-java-museo",
  "private": true,
  "scripts": {
    "dev": "nx run-many --target=dev --parallel=true",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"green,blue\" \"nx run backend:dev\" \"nx run frontend:dev\"",
    "build": "nx run-many --target=build",
    "test": "nx run-many --target=test",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@nx/gradle": "^20.0.0",
    "@nx/js": "^20.0.0",
    "concurrently": "^9.1.0",
    "nx": "^20.0.0",
    "typescript": "^5.7.0"
  }
}
