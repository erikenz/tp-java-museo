---
import Layout from "../layouts/Layout.astro";

// Server-side fetch for initial render
let categories = [];
let error = null;

try {
    const response = await fetch("http://localhost:8080/api/v1/categories");
    if (response.ok) {
        categories = await response.json();
    } else {
        error = "Failed to load categories";
    }
} catch (e) {
    error = "Backend unreachable";
}
---

<Layout title="Manage Categories">
    <main class="container mx-auto p-4 max-w-4xl">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold">Categories</h1>
            <a href="/" class="text-blue-500 hover:underline">Back to Dashboard</a>
        </div>

        {error && <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">{error}</div>}

        <div class="bg-white border rounded-lg shadow-sm p-6 mb-8">
            <h2 class="text-xl font-semibold mb-4" id="form-title">Add New Category</h2>
            <form id="category-form" class="flex gap-4">
                <input type="hidden" id="category-id" value="" />
                <input
                    type="text"
                    id="category-name"
                    placeholder="Category name"
                    required
                    class="flex-1 border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <button
                    type="submit"
                    class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors"
                >
                    Save Category
                </button>
                <button
                    type="button"
                    id="cancel-edit"
                    class="hidden bg-gray-200 text-gray-700 px-4 py-2 rounded hover:bg-gray-300 transition-colors"
                >
                    Cancel
                </button>
            </form>
        </div>

        <div class="bg-white border rounded-lg shadow-sm overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200" id="categories-list">
                    {categories.map((category) => (
                        <tr data-id={category.id}>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{category.id}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 category-name-cell">{category.name}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <button
                                    class="text-blue-600 hover:text-blue-900 mr-4 edit-btn"
                                    data-id={category.id}
                                    data-name={category.name}
                                >
                                    Edit
                                </button>
                                <button
                                    class="text-red-600 hover:text-red-900 delete-btn"
                                    data-id={category.id}
                                >
                                    Delete
                                </button>
                            </td>
                        </tr>
                    ))}
                    {categories.length === 0 && !error && (
                        <tr>
                            <td colspan="3" class="px-6 py-4 text-center text-gray-500">No categories found.</td>
                        </tr>
                    )}
                </tbody>
            </table>
        </div>
    </main>

    <script>
        const API_URL = 'http://localhost:8080/api/v1/categories';
        const form = document.getElementById('category-form') as HTMLFormElement;
        const inputId = document.getElementById('category-id') as HTMLInputElement;
        const inputName = document.getElementById('category-name') as HTMLInputElement;
        const formTitle = document.getElementById('form-title');
        const cancelBtn = document.getElementById('cancel-edit');
        const listBody = document.getElementById('categories-list');

        // Handle Form Submission (Create/Update)
        form?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const id = inputId.value;
            const name = inputName.value;

            const method = id ? 'PUT' : 'POST';
            const url = id ? `${API_URL}/${id}` : API_URL;

            try {
                const response = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name })
                });

                if (response.ok) {
                    window.location.reload(); // Simple way to refresh the list
                } else {
                    alert('Error saving category');
                }
            } catch (err) {
                console.error(err);
                alert('Network error');
            }
        });

        // Handle Edit Click
        document.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            if (target.classList.contains('edit-btn')) {
                const id = target.getAttribute('data-id');
                const name = target.getAttribute('data-name');

                if (id && name) {
                    inputId.value = id;
                    inputName.value = name;
                    formTitle!.textContent = 'Edit Category';
                    cancelBtn?.classList.remove('hidden');
                    inputName.focus();
                }
            }
        });

        // Handle Delete Click
        document.addEventListener('click', async (e) => {
            const target = e.target as HTMLElement;
            if (target.classList.contains('delete-btn')) {
                const id = target.getAttribute('data-id');
                if (id && confirm('Are you sure you want to delete this category?')) {
                    try {
                        const response = await fetch(`${API_URL}/${id}`, {
                            method: 'DELETE'
                        });

                        if (response.ok) {
                            window.location.reload();
                        } else {
                            alert('Error deleting category');
                        }
                    } catch (err) {
                        console.error(err);
                        alert('Network error');
                    }
                }
            }
        });

        // Handle Cancel Edit
        cancelBtn?.addEventListener('click', () => {
            inputId.value = '';
            inputName.value = '';
            formTitle!.textContent = 'Add New Category';
            cancelBtn.classList.add('hidden');
        });
    </script>
</Layout>
